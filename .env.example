# Optional: standalone is already the default. No API URL, credentials or backend needed.
VITE_DATA_MODE=standalone

# Server-side Vercel variables. Set the real key in Vercel Settings, never in Git.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
# Set 0 to disable provider calls without changing the rest of the demo.
AI_SUMMARY_ENABLED=1

# Optional browser switch: 0 disables live requests even in production.
# VITE_AI_SUMMARY=0
